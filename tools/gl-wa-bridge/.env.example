# Copy this file to .env in the same folder and fill in the blanks.
# Keep .env on the shop PC only. Do not commit it, do not paste it into chat.

SUPABASE_URL=https://db.grandlab.com.my
SUPABASE_ANON=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzkzMDY5NDExLCJleHAiOjE5NTA3NDk0MTF9.IcbPnDCd9p6Z-_FNMvzfg9k6ayX7IpC48zdGacAD_qw

# The reception staff login — the same one used for the Hub apps.
GL_EMAIL=
GL_PASSWORD=

# Full path to wacli if it is not on PATH, e.g. C:\Tools\wacli.exe
WACLI=wacli

# Only if you set up a named wacli account (wacli accounts add grandlab)
WACLI_ACCOUNT=

# How often to check for new messages, in seconds. 30 is plenty.
POLL_SECONDS=30

# How many recent messages to read from wacli each time.
BATCH_LIMIT=300

# ---- replies from the CRM board ----
# OFF by default. With this off the bridge only reads; it cannot send anything.
# Turn it on only when you want reception replying from the board.
SEND_ENABLED=0
# Never more than this many replies per check, spaced this many seconds apart.
SEND_MAX_PER_CYCLE=8
SEND_GAP_SECONDS=4

# ---- Telegram cards: who is waiting, with MIA's draft replies ----
# OFF unless BOTH of these are filled in. Use the bot token from @BotFather
# (the old "GL WA Approvals" bot is fine). The join code is any secret word:
# only the Telegram account that sends the bot  /start <join code>  can use it.
# Pick something others cannot guess. Do not paste either one into chat.
TELEGRAM_TOKEN=
TELEGRAM_JOIN_CODE=
# Send a card once a customer has waited this many minutes with no reply.
TELEGRAM_WAIT_MINUTES=3
# Only look at customers who wrote in the last this-many hours.
TELEGRAM_MAX_AGE_HOURS=6
# The name that goes on the front of a reply you approve in Telegram, in bold.
# Leave blank for no name.
TELEGRAM_SIGN_AS=Jimmy
# Numbers that never get a card (family, suppliers), comma separated, digits only.
TELEGRAM_IGNORE=
# Approved drafts are only sent when SEND_ENABLED=1 above.
